{
  "search.exclude": {
    "sources/**": true,
    "vendor/**": true
  },
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "jsonc",
    "yaml",
    "markdown"
  ],
  "cSpell.words": ["frontmatter", "oxfmt"]
}
